import { z } from "zod";
import { publicProcedure, protectedProcedure, csrfAdminProcedure, csrfBarberProcedure } from "../index";
import { TRPCError } from "@trpc/server";
import { Role } from "@prisma/client";
import { hashPassword } from "../lib/password";
export const authRouter = {
  login: publicProcedure
    .input(z.object({ email: z.string().email(), password: z.string().min(8) }))
    .mutation(async () => {
      // Login via Better Auth - delegado para o provedor de auth
      throw new TRPCError({
        code: "NOT_IMPLEMENTED",
        message: "Login é gerenciado pelo Better Auth endpoint",
      });
    }),

  me: protectedProcedure.query(({ ctx }) => {
    return {
      user: ctx.session.user,
      csrfToken: (ctx.session.user as { csrfToken?: string })?.csrfToken,
    };
  }),

  getCsrfToken: protectedProcedure.query(({ ctx }) => {
    const token = (ctx.session.user as { csrfToken?: string })?.csrfToken;
    if (!token) {
      throw new TRPCError({
        code: "INTERNAL_SERVER_ERROR",
        message: "CSRF token não disponível na sessão",
      });
    }
    return { csrfToken: token };
  }),

  logout: csrfBarberProcedure.mutation(async () => {
    // Logout delegado para Better Auth
    return { success: true };
  }),

  register: csrfAdminProcedure
    .input(
      z.object({
        email: z.string().email(),
        password: z.string().min(8),
        name: z.string().min(1),
        role: z.nativeEnum(Role).default(Role.BARBER),
      })
    )
    .mutation(async ({ ctx, input }) => {
      const user = await ctx.prisma.user.create({
        data: {
          email: input.email,
          passwordHash: await hashPassword(input.password),
          name: input.name,
          role: input.role,
        },
      });
      return { user };
    }),
};