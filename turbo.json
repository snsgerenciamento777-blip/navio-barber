{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["db:generate"]
    },
    "dev": {
      "cache": false
    },
    "db:generate": {
      "outputs": []
    },
    "db:migrate:dev": {
      "outputs": []
    }
  },
  "globalDependencies": [".env.*"],
  "globalEnv": [
    "DATABASE_URL",
    "NEXTAUTH_SECRET",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_API_URL",
    "API_URL",
    "PORT",
    "NODE_ENV",
    "FIREBASE_PROJECT_ID"
  ]
}