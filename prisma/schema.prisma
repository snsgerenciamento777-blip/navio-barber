// Prisma Schema — Navio Barber 2.0 MVP
// Baseado em docs/specs/ARQUITETURA_TECNICA.md (seção 4.2)
// Fase 0 — Spec Kit (especificação apenas, sem implementação)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?
  passwordHash String? @map("password_hash")
  name      String
  emailVerified Boolean @default(false) @map("email_verified")
  image     String?  @map("image_url")
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shops           Shop[]
  professionals   Professional[]
  fcmTokens       FCMToken[]
  notifications   Notification[]
  accounts        Account[]
  sessions        Session[]

  @@map("users")
}

model Account {
  id                String   @id @default(uuid())
  accountId         String
  providerId        String
  userId            String   @map("user_id")
  accessToken       String?
  refreshToken      String?
  idToken           String?
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope             String?
  password          String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  token        String   @unique
  userId       String   @map("user_id")
  expiresAt    DateTime @map("expires_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Verification {
  id           String   @id @default(uuid())
  identifier   String
  value        String
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

model Shop {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  email     String?
  logoUrl   String?  @map("logo_url")
  category  String?
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner        User       @relation(fields: [ownerId], references: [id])
  professionals Professional[]
  services      Service[]
  customers     Customer[]
  appointments  Appointment[]
  absences      EmployeeAbsence[]
  packagesSold  PackageSold[]
  promoCodes    PromoCode[]
  waitlists     Waitlist[]
  brandColors   Json?   @map("brand_colors")
  reviews       Review[]
  portfolio     Portfolio[]

  @@map("shops")
}

model Professional {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  userId    String?  @map("user_id")
  name      String
  bio       String?   @map("bio")
  location  String?   @map("location")
  // working_hours: jsonb {"mon":["09:00","18:00"],...,"sun":null}
  workingHours Json?   @map("working_hours") @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  shop       Shop       @relation(fields: [shopId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])
  appointments Appointment[]
  waitlists     Waitlist[]
  reviews       Review[]
  portfolio     Portfolio[]

  @@map("professionals")
}

model Service {
  id              String   @id @default(uuid())
  shopId          String   @map("shop_id")
  name            String
  category        String?
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int        @default(15) @map("duration_minutes")
  commissionPercent Decimal?   @default(0) @db.Decimal(5, 2) @map("commission_percent")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  shop         Shop      @relation(fields: [shopId], references: [id])
  appointments Appointment[]
  waitlists     Waitlist[]
  reviews       Review[]

  @@map("services")
}

model Customer {
  id            String   @id @default(uuid())
  shopId        String   @map("shop_id")
  fullName      String   @map("full_name")
  phone         String
  email         String?
  birthDate     DateTime? @map("birth_date")
  preferences   String?
  status        CustomerStatus @default(NEW)
  noShowCount   Int        @default(0) @map("no_show_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shop        Shop        @relation(fields: [shopId], references: [id])
  appointments Appointment[]
  waitlists     Waitlist[]
  reviews       Review[]

  @@map("customers")
  @@index([shopId, phone], name: "idx_customers_shop_phone")
}

enum CustomerStatus {
  NEW
  ACTIVE
  INACTIVE
  BLOCKED
}

model Appointment {
  id            String   @id @default(uuid())
  shopId        String   @map("shop_id")
  professionalId String   @map("professional_id")
  serviceId     String   @map("service_id")
  customerId    String   @map("customer_id")
  startAt       DateTime @map("start_at")
  endAt         DateTime @map("end_at")
  status        AppointmentStatus @default(PENDING)
  totalValue    Decimal  @db.Decimal(10, 2) @map("total_value")
  paymentMethod PaymentMethod? @map("payment_method")
  paymentStatus PaymentStatus?   @default(PENDING) @map("payment_status")
  notes         String?
  cancelReason  String?   @map("cancel_reason")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shop        Shop        @relation(fields: [shopId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
  payment     Payment?
  auditLogs   AppointmentAuditLog[]
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])
  promoCodeId String?   @map("promo_code_id")
  discountCents Int      @default(0) @map("discount_cents")

  @@map("appointments")
  @@index([shopId, startAt], name: "idx_appointments_shop_start")
  @@index([professionalId, startAt], name: "idx_appointments_professional_start")
  @@index([status], name: "idx_appointments_status")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  PIX
  VOUCHER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model Payment {
  id            String   @id @default(uuid())
  appointmentId String   @unique @map("appointment_id")
  amount        Decimal  @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime @default(now()) @map("created_at")

  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@map("payments")
}

model FCMToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  deviceType  String?  @map("device_type")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User @relation(fields: [userId], references: [id])

  @@map("fcm_tokens")
  @@index([userId], name: "idx_fcm_tokens_user")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  typeKey   String   @map("type_key")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user     User @relation(fields: [userId], references: [id])

  @@map("notifications")
  @@index([userId, isRead], name: "idx_notifications_user_read")
}

model EmployeeAbsence {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  professionalId String @map("professional_id")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  shop     Shop @relation(fields: [shopId], references: [id])

  @@map("employee_absences")
}

model PackageSold {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  customerId String  @map("customer_id")
  serviceId  String  @map("service_id")
  quantity   Int
  totalValue Decimal @db.Decimal(10, 2) @map("total_value")
  soldAt    DateTime @default(now()) @map("sold_at")

  shop     Shop @relation(fields: [shopId], references: [id])

  @@map("packages_sold")
}

model AppointmentAuditLog {
  id        String   @id @default(uuid())
  appointmentId String @map("appointment_id")
  oldStatus   AppointmentStatus? @map("old_status")
  newStatus   AppointmentStatus @map("new_status")
  reason      String
  source      AuditSource @map("source")
  changedBy   String?  @map("changed_by")
  changedAt   DateTime @default(now()) @map("changed_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("appointment_audit_logs")
  @@index([appointmentId], name: "idx_audit_logs_appointment")
  @@index([changedAt], name: "idx_audit_logs_changed")
}

enum AuditSource {
  SYSTEM
  MANUAL
}

enum Role {
  CUSTOMER
  BARBER
  ADMIN
}

model PromoCode {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  code      String
  kind      PromoKind @default(PERCENT)
  value     Int      // percent: 0-100; amount: reais (converted to cents at apply time)
  active    Boolean  @default(true)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  shop       Shop       @relation(fields: [shopId], references: [id])
  appointments Appointment[]

  @@map("promo_codes")
  @@index([shopId, code], name: "idx_promo_codes_shop_code")
}

enum PromoKind {
  PERCENT
  AMOUNT
}

model Waitlist {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  customerId String   @map("customer_id")
  professionalId String @map("professional_id")
  serviceId  String   @map("service_id")
  desiredDate DateTime @map("desired_date")
  status     WaitlistStatus @default(WAITING)
  createdAt  DateTime @default(now()) @map("created_at")

  shop        Shop @relation(fields: [shopId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  service     Service @relation(fields: [serviceId], references: [id])

  @@map("waitlist")
  @@index([professionalId, desiredDate], name: "idx_waitlist_professional_date")
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  FULFILLED
  CANCELLED
}

model Review {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  customerId String   @map("customer_id")
  professionalId String? @map("professional_id")
  serviceId  String?  @map("service_id")
  rating     Int      @map("rating")
  comment    String?  @map("comment")
  createdAt  DateTime @default(now()) @map("created_at")

  shop        Shop @relation(fields: [shopId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  service     Service? @relation(fields: [serviceId], references: [id])

  @@map("reviews")
  @@index([shopId], name: "idx_reviews_shop")
  @@index([professionalId], name: "idx_reviews_professional")
  @@index([rating], name: "idx_reviews_rating")
}

model Portfolio {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  professionalId String @map("professional_id")
  title     String?  @map("title")
  description String? @map("description")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  shop        Shop @relation(fields: [shopId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@map("portfolio")
  @@index([professionalId], name: "idx_portfolio_professional")
}