# Navio Barber 2.0 — Variáveis de Ambiente (template)
# Copie para `.env` (raiz) e/ou para `apps/web/.env` e `apps/api/.env` conforme o ambiente.
# NUNCA commite arquivos `.env` com segredos reais.

# --- Banco de Dados (PostgreSQL: Supabase, Neon, ou self-hosted) ---
# Supabase pooler (exemplo): postgresql://postgres:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:PORTA/navio_barber?sslmode=require"

# --- Redis (jobs assíncronos: no-show, notificações) — opcional ---
REDIS_URL="redis://localhost:6379"

# --- Better Auth (obrigatório) ---
# Segredo criptográfico: mínimo 32 caracteres. Gerar: openssl rand -base64 32
BETTER_AUTH_SECRET="gerar-com-openssl-rand-base64-32-caracteres"
# URL pública do app (origem usada por auth/callbacks/cookies em produção)
BETTER_AUTH_URL="http://localhost:3000"

# --- URLs do app (recomendado em produção) ---
# Origem pública do frontend (usada para CORS/respostas no proxy tRPC e deve coincidir com BETTER_AUTH_URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# URL base da API tRPC alcançável pelo SERVIDOR Next.js (proxy /api/trpc -> API). Não é usada pelo browser.
# Em deploy separado (Render), aponte para a URL pública/privada da API, ex.: https://navio-barber-api.onrender.com
API_URL="http://localhost:3001"
# Compatibilidade legada (fallback do proxy). Prefira API_URL no servidor.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- API (standalone) ---
PORT=3001

# --- Legado (avaliar remoção se não utilizado) ---
NEXTAUTH_SECRET="gerar-com-openssl-rand-base64-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# --- Firebase FCM (opcional no MVP) ---
FIREBASE_PROJECT_ID="SEU_PROJETO_FIREBASE_ID"
FIREBASE_CLIENT_EMAIL="SEU_SERVICO@SEU_PROJETO.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="SUA_CHAVE_PRIVADA_DO_FIREBASE"

# --- Ambiente ---
NODE_ENV="development"